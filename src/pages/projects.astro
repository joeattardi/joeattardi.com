---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import ProjectCard from '../components/ProjectCard.astro';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout title="Projects" description="Software projects by Joe Attardi.">
  <PageHeader
    title="Projects"
    intro="Software projects I have built and maintain."
  />
  <div class="mx-auto grid max-w-content gap-6 px-4 pb-16 sm:px-6 md:grid-cols-2 lg:grid-cols-3">
    {projects.map((project) => (
      <ProjectCard project={project} />
    ))}
  </div>
</BaseLayout>
