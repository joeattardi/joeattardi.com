---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const books = await getCollection('books');
  return books.map((book) => ({ params: { id: book.id }, props: { book } }));
}

const { book } = Astro.props;
const {
  title,
  publisher,
  publishedDate,
  cover,
  coverAlt,
  summary,
  amazonUrl,
  purchaseUrl,
  toc,
} = book.data;
const { Content } = await render(book);
---

<BaseLayout title={title} description={summary}>
  <article class="max-w-content mx-auto px-4 py-12 sm:px-6 md:py-16">
    <a
      href="/books"
      class="text-primary hover:text-primary-hover inline-flex min-h-11 items-center gap-2 font-medium"
    >
      <Icon name="ph:arrow-left" class="size-5" aria-hidden="true" />
      All books
    </a>
    <div class="mt-6 grid gap-8 md:grid-cols-[16rem_1fr] md:gap-12">
      <Image
        src={cover}
        alt={coverAlt}
        width={480}
        class="border-border aspect-[3/4] w-48 rounded-md border -rotate-2 object-cover md:w-full motion-safe:animate-cover-reveal"
      />
      <div>
        <p class="text-fg-muted text-sm">
          {publisher} &middot;
          <time datetime={publishedDate.toISOString()}>
            {publishedDate.toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
            })}
          </time>
        </p>
        <h1 class="mt-2 text-4xl font-bold tracking-tight">{title}</h1>
        <p class="text-fg-muted mt-4 max-w-prose text-lg">{summary}</p>
        <div class="mt-6 max-w-prose space-y-4">
          <Content />
        </div>
        <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-2">
          <a
            href={amazonUrl}
            rel="noopener"
            class="bg-primary text-primary-fg hover:bg-primary-hover inline-flex min-h-11 items-center gap-2 rounded-md px-5 font-medium transition-colors"
          >
            Buy on Amazon
            <Icon name="ph:arrow-up-right" class="size-5" aria-hidden="true" />
          </a>
          {purchaseUrl && (
            <a
              href={purchaseUrl}
              rel="noopener"
              class="text-primary hover:text-primary-hover inline-flex min-h-11 items-center gap-2 font-medium transition-colors"
            >
              Also at {publisher}
              <Icon
                name="ph:arrow-up-right"
                class="size-5"
                aria-hidden="true"
              />
            </a>
          )}
        </div>
      </div>
    </div>
    {toc.length > 0 && (
      <section class="mt-14 md:mt-20" aria-labelledby="toc-heading">
        <h2 id="toc-heading" class="text-3xl font-bold tracking-tight">
          Table of contents
        </h2>
        <ol class="border-border mt-6 max-w-prose divide-y border-y divide-border">
          {toc.map((entry, i) => (
            <li class="grid grid-cols-[2.5rem_1fr] gap-x-2 py-4">
              <span
                class="text-accent font-mono text-sm leading-7"
                aria-hidden="true"
              >
                {String(i + 1).padStart(2, '0')}
              </span>
              <div>
                <h3 class="text-lg font-semibold">
                  <span class="sr-only">Chapter {i + 1}: </span>
                  {entry.title}
                </h3>
                <p class="text-fg-muted mt-1">{entry.description}</p>
              </div>
            </li>
          ))}
        </ol>
      </section>
    )}
  </article>
</BaseLayout>
