---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import FeaturedBook from '../../components/FeaturedBook.astro';
import BookCard from '../../components/BookCard.astro';

const [latest, ...others] = (await getCollection('books')).sort(
  (a, b) => b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf(),
);
---

<BaseLayout
  title="Books"
  description="Books by Joe Attardi, published with Apress and O’Reilly."
>
  <PageHeader
    title="Books"
    intro="Books I have written, published with Apress and O’Reilly."
  />
  <div class="mx-auto max-w-content px-4 pb-16 sm:px-6">
    {latest && (
      <div class="mb-12 md:mb-16">
        <FeaturedBook book={latest} />
      </div>
    )}
    {others.length > 0 && (
      <>
        <h2 class="mb-6 text-3xl font-bold tracking-tight">More books</h2>
        <div class="grid gap-6 lg:grid-cols-2">
          {others.map((book) => (
            <BookCard book={book} />
          ))}
        </div>
      </>
    )}
  </div>
</BaseLayout>
