---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import BookCard from '../../components/BookCard.astro';

const books = (await getCollection('books')).sort(
  (a, b) => b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf(),
);
---

<BaseLayout
  title="Books"
  description="Books by Joe Attardi, published with Apress and O’Reilly."
>
  <PageHeader
    title="Books"
    intro="Books I have written, published with Apress and O’Reilly."
  />
  <div class="mx-auto grid max-w-content gap-6 px-4 pb-16 sm:px-6 lg:grid-cols-2">
    {books.map((book) => (
      <BookCard book={book} />
    ))}
  </div>
</BaseLayout>
