---
import { Icon } from 'astro-icon/components';
import ThemeToggle from './ThemeToggle.astro';
import { nav, site } from '../data/site';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const isCurrent = (href: string) =>
  currentPath === href || currentPath.startsWith(`${href}/`);
const linkClass =
  'text-fg-muted hover:text-fg aria-[current=page]:text-fg aria-[current=page]:font-semibold inline-flex min-h-11 items-center rounded-md px-3 transition-colors';
---

<header class="border-border bg-bg/95 sticky top-0 z-40 border-b backdrop-blur-sm">
  <div class="mx-auto flex max-w-content items-center justify-between gap-4 px-4 py-2 sm:px-6">
    <a
      href="/"
      class="text-fg inline-flex min-h-11 items-center text-lg font-bold tracking-tight"
    >
      {site.name}
    </a>

    <div class="flex items-center gap-1">
      <nav aria-label="Main" class="hidden md:block">
        <ul class="flex items-center gap-1">
          {nav.map((item) => (
            <li>
              <a
                href={item.href}
                class={linkClass}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <ThemeToggle />

      <details class="group relative md:hidden">
        <summary
          class="text-fg hover:bg-surface-raised inline-flex size-11 cursor-pointer list-none items-center justify-center rounded-md transition-colors [&::-webkit-details-marker]:hidden"
          aria-label="Menu"
        >
          <Icon
            name="ph:list"
            class="size-6 group-open:hidden"
            aria-hidden="true"
          />
          <Icon
            name="ph:x"
            class="hidden size-6 group-open:block"
            aria-hidden="true"
          />
        </summary>
        <nav
          aria-label="Mobile"
          class="bg-surface border-border absolute right-0 mt-2 w-56 rounded-lg border p-2 shadow-lg"
        >
          <ul>
            {nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  class={`${linkClass} w-full`}
                  aria-current={isCurrent(item.href) ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>
