---
import { Icon } from 'astro-icon/components';
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import { nav, site } from '../data/site';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const isCurrent = (href: string) =>
  currentPath === href || currentPath.startsWith(`${href}/`);
const linkClass =
  'text-fg-muted hover:text-fg aria-[current=page]:text-fg aria-[current=page]:font-semibold inline-flex min-h-11 items-center rounded-md px-3 transition-colors';
---

<header class="border-border bg-bg/95 sticky top-0 z-40 border-b backdrop-blur-sm">
  <div class="mx-auto flex max-w-content items-center justify-between gap-4 px-4 py-2 sm:px-6">
    <a
      href="/"
      class="text-fg font-serif inline-flex min-h-11 items-center text-xl font-semibold tracking-tight gap-2.5"
    >
      <Logo class="size-8" />
      <span class="site-name">{site.name}</span>
    </a>

    <div class="flex items-center gap-1">
      <nav aria-label="Main" class="hidden md:block">
        <ul class="flex items-center gap-1">
          {nav.map((item, i) => (
            <li class="nav-item" style={`--i: ${i}`}>
              <a
                href={item.href}
                class={linkClass}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <ThemeToggle />

      <button
        type="button"
        id="mobile-nav-open"
        class="text-fg hover:bg-surface-raised inline-flex size-11 items-center justify-center rounded-md transition-colors md:hidden"
        aria-label="Menu"
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <Icon name="ph:list" class="size-6" aria-hidden="true" />
      </button>
    </div>
  </div>

  <!-- showModal() puts this in the top layer, so it covers the viewport despite the header's backdrop-blur -->
  <dialog
    id="mobile-nav"
    aria-label="Menu"
    class="bg-bg text-fg m-0 h-dvh max-h-none w-full max-w-none opacity-0 transition-[opacity,display,overlay] transition-discrete duration-200 backdrop:bg-transparent open:opacity-100 starting:open:opacity-0 md:hidden"
  >
    <div class="mx-auto flex h-full max-w-content flex-col px-4 py-2 sm:px-6">
      <div class="flex items-center justify-between gap-4">
        <a
          href="/"
          class="text-fg font-serif inline-flex min-h-11 items-center text-xl font-semibold tracking-tight gap-2.5"
        >
          <Logo class="size-8" />
          {site.name}
        </a>
        <button
          type="button"
          id="mobile-nav-close"
          class="text-fg hover:bg-surface-raised inline-flex size-11 items-center justify-center rounded-md transition-colors"
          aria-label="Close menu"
        >
          <Icon name="ph:x" class="size-6" aria-hidden="true" />
        </button>
      </div>

      <nav aria-label="Mobile" class="mt-6">
        <ul class="flex flex-col items-end gap-2 text-right">
          {nav.map((item) => (
            <li>
              <a
                href={item.href}
                class="text-fg-muted hover:text-fg aria-[current=page]:text-fg font-serif inline-flex min-h-11 items-center py-2 text-4xl font-semibold tracking-tight transition-colors"
                aria-current={isCurrent(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </dialog>
</header>

<style>
  /* Fades in as the logo finishes drawing (see Logo.astro); nav links stagger in alongside */
  @media (prefers-reduced-motion: no-preference) {
    /* `scale` is separate from `transform`, so the intro's fill doesn't override it */
    .site-name {
      transform-origin: left center;
      transition: scale 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    :global(a:hover) > .site-name,
    :global(a:focus-visible) > .site-name {
      scale: 1.05;
    }
    :global(html.intro) .site-name {
      animation: site-name-in 0.5s ease-out 0.7s both;
    }
    :global(html.intro) .nav-item {
      animation: nav-item-in 0.5s ease-out calc(0.7s + var(--i) * 0.1s) both;
    }
  }

  @keyframes site-name-in {
    from {
      opacity: 0;
      transform: translateX(-0.25rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes nav-item-in {
    from {
      opacity: 0;
      transform: translateY(-0.25rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  const dialog = document.getElementById('mobile-nav') as HTMLDialogElement;
  const openButton = document.getElementById('mobile-nav-open');
  const closeButton = document.getElementById('mobile-nav-close');

  openButton?.addEventListener('click', () => {
    dialog.showModal();
    openButton.setAttribute('aria-expanded', 'true');
  });
  closeButton?.addEventListener('click', () => dialog.close());
  dialog.addEventListener('close', () =>
    openButton?.setAttribute('aria-expanded', 'false'),
  );

  // Don't leave the overlay open if the viewport grows past the mobile breakpoint
  window
    .matchMedia('(min-width: 48rem)')
    .addEventListener('change', (e) => e.matches && dialog.close());
</script>
