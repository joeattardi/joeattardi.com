---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<!-- JA ligature: the J's stem doubles as the A's left leg. Paths match public/favicon.svg -->
<svg
  viewBox="4 4 24 24"
  fill="none"
  stroke-width="3"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
>
  <path class="stroke-primary" d="M19.3 6.3 25.8 23.3M15.9 17.3h7.6"></path>
  <path
    class="stroke-fg"
    d="M12.8 6.3h6.5l-6 15.5q-1.8 4.6-5.4 3.3-2-.8-1.8-3.5"
  ></path>
</svg>
