---
import { Icon } from 'astro-icon/components';
import { socials } from '../data/site';

interface Props {
  /** Append a link to the blog's RSS feed */
  feed?: boolean;
}

const { feed = false } = Astro.props;
const links = feed
  ? [...socials, { label: 'RSS feed', href: '/blog/rss.xml', icon: 'ph:rss' }]
  : socials;
---

<ul class="flex flex-wrap items-center gap-1">
  {links.map((s) => (
    <li>
      <a
        href={s.href}
        aria-label={s.label}
        class="text-fg-muted hover:text-primary hover:bg-surface-raised inline-flex size-11 items-center justify-center rounded-md transition-colors"
      >
        <Icon name={s.icon} class="size-6" aria-hidden="true" />
      </a>
    </li>
  ))}
</ul>
