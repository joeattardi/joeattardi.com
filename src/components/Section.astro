---
interface Props {
  title: string;
  href?: string;
  linkLabel?: string;
}

const { title, href, linkLabel } = Astro.props;
---

<section class="mx-auto max-w-content px-4 py-10 sm:px-6 md:py-14">
  <div class="mb-6 flex items-end justify-between gap-4">
    <h2 class="text-3xl font-bold tracking-tight">{title}</h2>
    {href && (
      <a
        href={href}
        class="text-primary hover:text-primary-hover inline-flex min-h-11 items-center font-medium transition-colors"
      >
        {linkLabel ?? 'View all'}
      </a>
    )}
  </div>
  <slot />
</section>
