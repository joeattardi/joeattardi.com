---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  book: CollectionEntry<'books'>;
}

const { book } = Astro.props;
const { title, publisher, publishedDate, cover, coverAlt, summary } = book.data;
---

<article class="group bg-surface border-border hover:border-primary relative flex flex-col gap-5 rounded-xl border p-5 transition-[border-color,box-shadow,translate] duration-300 hover:shadow-lg motion-safe:hover:-translate-y-1 sm:flex-row">
  <div class="shrink-0 py-2 pl-2">
    <Image
      src={cover}
      alt={coverAlt}
      width={240}
      class="border-border aspect-[3/4] w-32 rounded-md border object-cover shadow-md transition-[rotate,scale,box-shadow] duration-300 group-odd:-rotate-3 group-even:rotate-3 group-hover:rotate-0 group-hover:shadow-xl motion-safe:group-hover:scale-105"
    />
  </div>
  <div class="flex flex-col items-start">
    <p class="text-fg-muted text-sm">
      {publisher} &middot;
      <time datetime={publishedDate.toISOString()}>
        {publishedDate.getFullYear()}
      </time>
    </p>
    <h3 class="mt-1 text-2xl font-semibold tracking-tight">
      <a
        href={`/books/${book.id}`}
        class="group-hover:text-primary transition-colors after:absolute after:inset-0 after:rounded-xl after:content-['']"
      >
        {title}
      </a>
    </h3>
    <p class="text-fg-muted mt-2">{summary}</p>
  </div>
</article>
