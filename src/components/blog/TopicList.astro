---
import { tagHref, type Post, getTags } from '../../lib/blog';

interface Props {
  posts: Post[];
  current?: string;
}

const { posts, current } = Astro.props;
const tags = getTags(posts);
---

<nav aria-labelledby="topics-heading">
  <h2
    id="topics-heading"
    class="text-fg-muted font-sans text-sm font-semibold tracking-wide uppercase"
  >
    Browse by topic
  </h2>
  <ul class="mt-3 flex flex-wrap gap-2">
    {tags.map(({ name, count }) => (
      <li>
        <a
          href={tagHref(name)}
          aria-current={name === current ? 'page' : undefined}
          class="bg-surface text-fg-muted border-border hover:border-primary hover:text-fg aria-[current=page]:bg-primary aria-[current=page]:text-primary-fg aria-[current=page]:border-primary inline-flex min-h-11 items-center gap-2 rounded-lg border px-3 text-sm font-medium transition-colors"
        >
          {name}
          <span class="font-mono text-xs">
            <span class="sr-only">(</span>
            {count}
            <span class="sr-only"> posts)</span>
          </span>
        </a>
      </li>
    ))}
  </ul>
</nav>
