---
import { titleSegments } from '../../lib/blog';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

{titleSegments(title).map(({ text, code }) =>
  code ? <code class="title-code font-mono">{text}</code> : text,
)}

<style>
  /* Monospace runs large next to serif display type */
  .title-code {
    font-size: 0.85em;
    letter-spacing: -0.02em;
  }
</style>
