---
import { formatDate, readingTime, type Post } from '../../lib/blog';
import TagList from './TagList.astro';
import PostTitle from './PostTitle.astro';

interface Props {
  post: Post;
  headingLevel?: 2 | 3;
}

const { post, headingLevel = 3 } = Astro.props;
const { title, summary, publishedDate, tags } = post.data;
const Heading = headingLevel === 2 ? 'h2' : 'h3';
---

<!-- Rows are subgrid children of PostArchive's list, so the date column lines up across rows -->
<li class="group border-border relative col-span-full grid grid-cols-subgrid gap-y-2 border-b py-6 first:pt-0 last:border-b-0">
  <p class="text-fg-muted font-mono text-sm md:pt-2">
    <time datetime={publishedDate.toISOString()}>
      {formatDate(publishedDate, 'short')}
    </time>
  </p>
  <div>
    <Heading class="text-2xl font-semibold tracking-tight text-balance">
      <a
        href={`/blog/${post.id}`}
        class="group-hover:text-primary transition-colors after:absolute after:inset-0 after:content-['']"
      >
        <PostTitle title={title} />
      </a>
    </Heading>
    <p class="text-fg-muted mt-2 max-w-prose">{summary}</p>
    <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-3">
      <p class="text-fg-muted text-sm">{readingTime(post)} min read</p>
      <TagList tags={tags} />
    </div>
  </div>
</li>
