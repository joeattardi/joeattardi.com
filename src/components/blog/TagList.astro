---
import { tagHref } from '../../lib/blog';

interface Props {
  tags: string[];
  class?: string;
}

const { tags, class: className } = Astro.props;
// The pseudo-element extends each link's hit area to 44px without enlarging the chip
---

{tags.length > 0 && (
  <ul class:list={['flex flex-wrap gap-2', className]} aria-label="Tags">
    {tags.map((tag) => (
      <li>
        <a
          href={tagHref(tag)}
          class="bg-surface-raised text-fg-muted border-border hover:border-primary hover:text-fg relative z-10 inline-block rounded-md border px-2 py-1 font-mono text-sm transition-colors before:absolute before:inset-x-0 before:-inset-y-2 before:content-['']"
        >
          {tag}
        </a>
      </li>
    ))}
  </ul>
)}
